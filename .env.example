# Copy to .env.local for development. Never commit real credentials.
# Optional until you enable account-backed features; the landing page renders without these.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: Supabase's secret key. Legacy SERVICE_ROLE_KEY is also supported.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# PUBLIC_SUPABASE_ANON_KEY=

# Server-only: 32 cryptographically random bytes, encoded as standard base64.
# Keep this stable/backed up; changing it makes existing stored provider keys unreadable.
AI_SETTINGS_ENCRYPTION_KEY=

# Optional for the one-time bootstrap script, not a runtime authorization shortcut.
ROOT_ADMIN_EMAIL=

# OpenRouter and OpenAI API keys are entered only at /admin/ai after root bootstrap.
# They are encrypted on the server and stored in the database, not in PUBLIC_* variables.
